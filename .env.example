# Copie para `.env` e ajuste. O servidor lê o `.env` da raiz sozinho ao subir
# (server/ambiente.js); variável que já vier do ambiente — PM2, Docker — ganha
# do arquivo. O `.env` não vai para o git.

# Porta em que o servidor escuta.
PORT=3000

# Endereço em que ele escuta. 0.0.0.0 aceita conexões de fora da máquina;
# 127.0.0.1 só de dentro (use isso quando houver Nginx na frente).
HOST=0.0.0.0

# Em "production" o cookie de sessão só viaja por HTTPS. Deixe assim no
# servidor de verdade, e vazio (ou "development") quando rodar no seu PC.
NODE_ENV=production

# Onde fica o banco. Por padrão é `dados/` dentro do projeto; aponte para um
# volume/disco persistente quando hospedar num serviço que recria o container.
# Contas (nome de usuário, não de personagem) que podem usar /evento no chat,
# separadas por vírgula.
# ADMINS=seu_usuario

# DB_DIR=/var/lib/resenha
# DB_PATH=/var/lib/resenha/resenha.db
